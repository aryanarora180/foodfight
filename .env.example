# Copy to .env.local for local dev, and set these in Vercel Project Settings > Environment Variables for deployment.

# Required. Cookie-signing secret for iron-session — any random string, 32+ chars.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Comma-separated usernames that should always be admins, e.g. "aryan,sam".
# If left unset, the very first person to sign up becomes admin.
ADMIN_USERNAMES=

# Required in production (Vercel's filesystem is ephemeral / read-only).
# Create a free Redis database via Project Settings > Storage and this gets
# populated automatically when you connect it to this project. Locally,
# leaving it unset falls back to a .data/state.json file on disk.
REDIS_URL=
